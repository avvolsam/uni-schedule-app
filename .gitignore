# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated daily by scripts/fetch-schedule.mjs — never committed, only produced at
# build time (locally via `npm run fetch-data`, or in CI before `npm run build`).
public/data

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets must never be committed: OneSignal keys go into GitHub Actions secrets, not files.
.env
.env.*
!.env.example

# Previous-run schedule snapshot used by scripts/notify-changes.mjs (CI cache only).
.baseline
